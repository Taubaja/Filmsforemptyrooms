---
import Layout from '../../layouts/Layout.astro';
import directors from '../../data/directors.json';

export function getStaticPaths() {
  return directors.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const director = directors.find((d) => d.slug === slug);

if (!director) {
  return Astro.redirect('/404');
}
---

<Layout title={`${director.name} — Films for empty rooms`}>
  <div class="talent-page">
    <a href={`/#${director.slug}`} class="talent-page__back">&larr; Talents</a>

    <h1 class="talent-page__name">{director.name}</h1>

    <div class="talent-page__bio">
      {director.bio.split('\n').filter(p => p.trim()).map((p) => (
        <p>{p.trim()}</p>
      ))}
    </div>

    <a href={director.instagram} class="talent-page__instagram" target="_blank" rel="noopener noreferrer">Instagram</a>

    <div style="margin-top: 32px;">
      {director.films.map((film) => (
        <a href={`/talents/${director.slug}/${film.slug}`} style="display:block; margin-bottom: 48px;">
          <img
            src={film.thumbnail}
            alt={`${director.name} — ${film.client || ''} — ${film.title}`}
            loading="lazy"
            style="width:100%; aspect-ratio: 16/9; object-fit: cover;"
          />
          <p style="font-family: var(--font-sans); font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text); margin-top: 8px;">
            {film.client ? `${film.client} — ` : ''}{film.title}
          </p>
        </a>
      ))}
    </div>
  </div>
</Layout>
