---
import Layout from '../../../layouts/Layout.astro';
import directors from '../../../data/directors.json';

export function getStaticPaths() {
  return directors.flatMap((director) =>
    director.films.map((film) => ({
      params: { director: director.slug, film: film.slug },
      props: { film, director }
    }))
  );
}

const { film, director } = Astro.props;
const canonicalUrl = `https://filmsforemptyrooms.com/films/${director.slug}/${film.slug}`;

const filmOgImage =
  film.stills?.[0] ||
  film.thumbnail ||
  director.ogImage ||
  director.homeImages?.[0] ||
  'https://filmsforemptyrooms.com/og-image.png';

const otherFilms = director.films.filter((f) => f.slug !== film.slug).slice(0, 3);
---

<Layout
  title={`${film.title} — ${director.name} — Films for Empty Rooms`}
  description={film.synopsis}
  ogImage={filmOgImage}
  ogUrl={canonicalUrl}
  ogType="video.movie"
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Movie',
    'name': film.title,
    'director': {
      '@type': 'Person',
      'name': director.name,
      'url': `https://filmsforemptyrooms.com/realisateurs/${director.slug}`
    },
    'dateCreated': film.year.toString(),
    'description': film.synopsis,
    'image': filmOgImage,
    'url': canonicalUrl,
    'productionCompany': {
      '@type': 'Organization',
      'name': 'Films for Empty Rooms',
      'url': 'https://filmsforemptyrooms.com'
    },
    'genre': film.category
  })} />

  <div class="film-page">
    <a href="/" class="film-page__back" data-director-back>&larr; Films for Empty Rooms</a>

    <div class="film-player">
      <iframe
        src={`https://player.vimeo.com/video/${film.vimeoId}?h=0&title=0&byline=0&portrait=0&color=ffffff`}
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        playsinline
        webkit-playsinline
      ></iframe>
    </div>

    <div class="film-page__content">
      <div class="film-page__header">
        <h1 class="film-page__title">{film.title}</h1>
        <span class="film-page__year">{film.year}</span>
      </div>

      <div class="film-page__meta">
        <a href={`/realisateurs/${director.slug}`} class="film-page__meta-link" data-director-link>{director.name}</a>
        {film.client && (<> — <span>{film.client}</span></>)}
        {film.category && (<> — <span>{film.category}</span></>)}
      </div>

      {film.synopsis && (
        <div class="film-page__synopsis">
          <p>{film.synopsis}</p>
        </div>
      )}

      <div class="film-page__credits">
        <div class="film-page__credit">
          <span class="film-page__credit-label">Réalisateur</span>
          <span class="film-page__credit-value"><a href={`/realisateurs/${director.slug}`} data-director-link>{director.name}</a> ↗</span>
        </div>
        {film.client && (
          <div class="film-page__credit">
            <span class="film-page__credit-label">Client</span>
            <span class="film-page__credit-value">{film.client}</span>
          </div>
        )}
        {film.category && (
          <div class="film-page__credit">
            <span class="film-page__credit-label">Catégorie</span>
            <span class="film-page__credit-value">{film.category}</span>
          </div>
        )}
        <div class="film-page__credit">
          <span class="film-page__credit-label">Année</span>
          <span class="film-page__credit-value">{film.year}</span>
        </div>
        {film.credits && film.credits.map((c) => (
          <div class="film-page__credit">
            <span class="film-page__credit-label">{c.role}</span>
            <span class="film-page__credit-value">{c.name}</span>
          </div>
        ))}
      </div>

      {film.stills && film.stills.length > 0 && (
        <div class="film-page__stills-section">
          <h3 class="film-page__section-title">Galerie</h3>
          <div class="film-stills">
            {film.stills.map((still, i) => (
              <img src={still} alt={`${film.title} — still ${i + 1}`} loading="lazy" class="film-stills__img" />
            ))}
          </div>
        </div>
      )}

      {otherFilms.length > 0 && (
        <div class="film-page__next-section">
          <h3 class="film-page__section-title">Autres films — {director.name.toUpperCase()}</h3>
          <div class="next-films">
            {otherFilms.map((f) => (
              <a href={`/films/${director.slug}/${f.slug}`} class="next-film" data-director-link>
                <div class="next-film__img">
                  <img src={f.thumbnail} alt={f.title} loading="lazy" />
                </div>
                <p class="next-film__client">{f.client}</p>
                <p class="next-film__title">{f.title}</p>
                <p class="next-film__year">{f.year}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  (function() {
    var backLink = document.querySelector('[data-director-back]');
    if (backLink) {
      backLink.addEventListener('click', function(e) {
        e.preventDefault();
        document.body.classList.add('curtain-down');
        setTimeout(function() {
          window.location.href = '/';
        }, 800);
      });
    }

    // Lightbox for stills with navigation
    var lightbox = document.createElement('div');
    lightbox.className = 'lightbox';
    var lbImg = document.createElement('img');
    var lbPrev = document.createElement('button');
    lbPrev.className = 'lightbox__prev';
    lbPrev.innerHTML = '<svg width="24" height="24" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="10 2 4 8 10 14" /></svg>';
    var lbNext = document.createElement('button');
    lbNext.className = 'lightbox__next';
    lbNext.innerHTML = '<svg width="24" height="24" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 2 12 8 6 14" /></svg>';
    var lbCounter = document.createElement('span');
    lbCounter.className = 'lightbox__counter';
    var lbClose = document.createElement('button');
    lbClose.className = 'lightbox__close';
    lbClose.innerHTML = '<svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="1" y1="1" x2="15" y2="15" /><line x1="15" y1="1" x2="1" y2="15" /></svg>';
    lightbox.appendChild(lbImg);
    lightbox.appendChild(lbPrev);
    lightbox.appendChild(lbNext);
    lightbox.appendChild(lbCounter);
    lightbox.appendChild(lbClose);
    document.body.appendChild(lightbox);

    var lbImages = [];
    var lbIndex = 0;

    function openLightbox(images, index) {
      lbImages = images;
      lbIndex = index || 0;
      lbImg.src = lbImages[lbIndex];
      lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length;
      lbPrev.style.display = lbImages.length > 1 ? '' : 'none';
      lbNext.style.display = lbImages.length > 1 ? '' : 'none';
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox || e.target === lbImg) closeLightbox();
    });
    lbClose.addEventListener('click', closeLightbox);
    lbPrev.addEventListener('click', function(e) { e.stopPropagation(); lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; lbImg.src = lbImages[lbIndex]; lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length; });
    lbNext.addEventListener('click', function(e) { e.stopPropagation(); lbIndex = (lbIndex + 1) % lbImages.length; lbImg.src = lbImages[lbIndex]; lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length; });

    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; lbImg.src = lbImages[lbIndex]; lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length; }
      if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbImages.length; lbImg.src = lbImages[lbIndex]; lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length; }
    });

    document.addEventListener('click', function(e) {
      var img = e.target.closest('.film-stills__img');
      if (!img) return;
      var container = img.closest('.film-stills');
      var allImgs = container ? Array.from(container.querySelectorAll('img')) : [];
      var idx = allImgs.indexOf(img);
      openLightbox(allImgs.map(function(i) { return i.src; }), idx);
    });
  })();
</script>
